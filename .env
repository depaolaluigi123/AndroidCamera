# ACUS (USB Device) reconnections after an error: maximum retries, then stop.
# Mandatory. Used by the preview proxy (GUI) and the WebSocket player in the browser.
ACUS_MAX_RETRIES=3

# TOTAL number of /dev/videoN slots that the v4l2loopback module creates at GUI
# startup. Equals the maximum number of phones that can be connected (each
# phone occupies one slot; a resolution change temporarily occupies a second
# one until OBS releases the old one). All these slots remain
# kernel-owned and free until assigned, so multiple phones can be enabled
# without unloading/reloading v4l2loopback while OBS/VLC holds a device open.
# Integer >= 1 (recommended >= 10 for room for multiple phones + resolution changes).
# Adjustable as desired.
V4L2_SLOTS=10

# Maximum number of concurrent HTTP requests during subnet scan of
# 192.168.1.0/24 (port 2743) when pressing "Refresh". A higher value
# speeds up the scan but consumes more network/CPU resources; too low
# makes it slow. 32 is a good compromise: 254 IPs scanned in ~2-3 seconds.
SUBNET_SCAN_MAX_CONCURRENT=32

