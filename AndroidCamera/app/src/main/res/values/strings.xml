<resources>
    <string name="app_name">AndroidCamera Webcam</string>
    <string name="app_subtitle">Turn your phone cameras into an OBS webcam</string>

    <string name="section_connection">Connection mode</string>
    <string name="mode_usb">USB Tethering</string>
    <string name="mode_usb_desc">Enable USB Tethering on the phone, then use the virtual webcam on the PC (selectable in OBS like a real camera)</string>
    <string name="mode_usb_device">USB Device</string>
    <string name="mode_usb_device_desc">USB debugging only (no tethering / Wi‑Fi). The PC driver receives binary frames over the USB cable (ADB) and exposes a real V4L2 webcam for OBS — no HTTP.</string>
    <string name="mode_ip">IP (LAN)</string>
    <string name="mode_ip_desc">Stream over Wi‑Fi using the device local IP</string>

    <string name="section_camera">Camera</string>
    <string name="camera_picker_label">Camera to stream</string>
    <string name="camera_picker_label_short">Camera:</string>
    <string name="camera_picker_hint">List depends on this phone hardware. Use the live preview above to confirm the lens.</string>
    <string name="camera_facing_back">Rear</string>
    <string name="camera_facing_front">Front</string>
