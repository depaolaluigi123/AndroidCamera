    <string name="obs_url_stream">Stream: %1$s</string>
    <string name="obs_hint_usb">On the PC open AndroidCameraLinuxGui and click Enable for OBS, then in OBS add Video Capture Device (V4L2) and select "%1$s".</string>
    <string name="obs_hint_usb_device">Keep USB debugging on. On the PC open AndroidCameraLinuxGui and click Enable for OBS — the USB driver creates webcam "%1$s" for OBS (no HTTP).</string>
    <string name="obs_hint_ip">On the PC open AndroidCameraLinuxGui and click Enable for OBS (or point a custom YUV pipeline at the URL above). In OBS select "%1$s".</string>
