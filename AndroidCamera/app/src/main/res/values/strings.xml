    <string name="section_video">Video quality</string>
    <string name="format_yuv_hint">Streams raw YUV for low latency. On the PC use AndroidCameraLinuxGui (Enable for OBS), then pick this phone by name in OBS.</string>
    <string name="resolution_label">Resolution</string>
    <string name="fps_label">Frame rate (FPS)</string>
    <string name="fps_hint">This sends a request to the camera sensor for the chosen frame rate. The sensor picks the closest supported value on its own, so the actual frame rate may be slightly different from what you select here.</string>
    <string name="limit_fps_label">Limit FPS</string>
    <string name="limit_fps_hint">When checked, the stream forwarded to the computer is capped to the FPS value selected above: any extra frames produced by the camera sensor are dropped. When unchecked, every frame produced by the camera is forwarded (the default behaviour).</string>
    <string name="rotate_180_label">Rotate 180°</string>
    <string name="rotate_180_hint">Adds an extra 180° rotation to every outgoing frame on top of the orientation selected above. Editable while the stream is running — takes effect on the next frame, no service restart required.</string>
    <string name="orientation_label">Camera orientation</string>
    <string name="orientation_portrait">Vertical</string>
    <string name="orientation_landscape">Horizontal</string>
    <string name="orientation_portrait_inverted">Vertical inverted</string>
    <string name="orientation_landscape_inverted">Horizontal inverted</string>
